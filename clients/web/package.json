{
  "name": "@unlimiting-studio/tools",
  "version": "0.2.0",
  "description": "unlimiting-studio tools API 웹 클라이언트 (프로필 사진 자동 크롭과 크롭 화면)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cropper": {
      "types": "./dist/cropper.d.ts",
      "import": "./dist/cropper.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/gen-css.mjs && tsc",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unlimiting-studio/tools.git",
    "directory": "clients/web"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cropperjs": "^1.7.0"
  }
}
